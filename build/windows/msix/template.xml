<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ctun"
        Arguments=""
        InstallLocation="C:\Program Files\ctun\ctun">
    </Installer>
    <PackageInformation
        PackageName="ctun"
        PackageDisplayName="ctun"
        PublisherName="CN=ctun"
        PublisherDisplayName="ctun"
        Version="0.1.0.0"
        PackageDescription="mihomo desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="dev.ctun.app"
                Description="mihomo desktop client"
                DisplayName="ctun"
                ExecutableName="ctun"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ctun</DisplayName>
            <PublisherDisplayName>ctun</PublisherDisplayName>
            <Description>mihomo desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ctun.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
